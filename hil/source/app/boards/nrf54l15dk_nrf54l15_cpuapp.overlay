 *
 * XIAO nRF54L15 source-fixture overrides for the stock nrf54l15dk target.
 */

/ {
	rfsw_ctl: rfsw-ctl {
		compatible = "regulator-fixed";
		regulator-name = "rfsw-ctl";
		enable-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
	};

	rfsw_pwr: rfsw-pwr {
		compatible = "regulator-fixed";
		regulator-name = "rfsw-pwr";
		enable-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};

&pinctrl {
	xiao_uart20_default: xiao_uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 8)>;
			bias-pull-up;
		};
	};

	xiao_uart20_sleep: xiao_uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
			low-power-enable;
		};
	};
};

&uart20 {
	pinctrl-0 = <&xiao_uart20_default>;
	pinctrl-1 = <&xiao_uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&button0 {
	status = "disabled";
};

&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&button3 {
	status = "disabled";
};

&mx25r64 {
	status = "disabled";
};

&spi00 {
	status = "disabled";
};

&lfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <16000>;
	status = "okay";
};

&hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <16000>;
	status = "okay";
};
