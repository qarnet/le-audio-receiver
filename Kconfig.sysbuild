# SPDX-License-Identifier: Apache-2.0

config NRF_DEFAULT_BLUETOOTH
	default y if SOC_NRF5340_CPUAPP

# Disable partition manager — sysbuild multi-image domains use DTS-defined
# memory regions independently (cpuapp_sram, cpuflpr_sram, etc.).
config PARTITION_MANAGER
	default n if SOC_NRF54L15_CPUAPP

source "share/sysbuild/Kconfig"
