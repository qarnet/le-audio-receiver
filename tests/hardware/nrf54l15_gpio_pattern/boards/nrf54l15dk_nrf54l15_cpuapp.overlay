/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Overlay for nRF54L15 GPIO pattern test running on Xiao hardware.
 *
 * Stock nrf54l15dk claims P1.4 (UART TX), P1.5 (UART RX), P1.6 (UART RTS
 * + SPI22 MOSI), P1.7 (UART CTS + SPI22 MISO). We need them as plain GPIO.
 *
 * UART20 is remapped to the Xiao SAMD11 CDC bridge (P1.9 TX / P1.8 RX)
 * for the boot banner. SPI22, PWM20, and the SPI flash are disabled.
 */

&pwm_led1 {
	status = "disabled";
};

&pinctrl {
	/* Delete stock uart20 pinctrl (P1.4–P1.7) */
	/delete-node/ uart20_default;
	/delete-node/ uart20_sleep;

	/* Replace with Xiao CDC pin assignments */
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 8)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
			low-power-enable;
		};
	};
};

&uart20 {
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Disable spi22 and clear its pinctrl references (keep pinctrl nodes intact).
 * The spi22_default/spi22_sleep pinctrl nodes remain defined but unused. */
&spi22 {
	status = "disabled";
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-names;
};

&pwm20 {
	status = "disabled";
};

/* Stock DK has mx25r64 on spi00; disable to silence probe error */
&mx25r64 {
	status = "disabled";
};

&spi00 {
	status = "disabled";
};
