# BSIM receiver Kconfig — minimal symbols repo needs for BSIM build.
# Repo Kconfig cannot be sourced directly (repo lives outside ZEPHYR_BASE
# which is the Kconfig srctree root).

mainmenu "LE Audio Receiver — BSIM"

config INFO_REPORTING_INTERVAL
	int "Number of SDUs between log reports"
	default 0

config BSIM_OBSERVER
	bool "BSim-only passive BAP flow observer"
	help
	  Compiles the passive observer (tests/bsim/src/bsim_observer.c) into
	  the receiver.  Emits/counts events from real production flow;
	  never drives production state.  Production builds do not define
	  this symbol.

config BSIM_SOURCE_ASE
	bool "BSim-only source PAC capability"
	help
	  Registers a source PAC capability so a BSim client can attempt a
	  source-direction Config and exercise the repository's source
	  rejection through the real ASCS server.  Production remains
	  sink-only (CONFIG_BT_ASCS_MAX_ASE_SRC_COUNT=0).

config BSIM_SINK_POOL_LIMIT
	int "BSim-only repository sink stream pool limit"
	default 2
	depends on BSIM_OBSERVER
	help
	  Limits the repository bt_sink stream pool below the BSim ASCS sink
	  ASE count so the NO_MEM callback path is reachable in BSim.
	  Production keeps the pool equal to CONFIG_BT_ASCS_MAX_ASE_SNK_COUNT
	  with no seam symbol.

choice AUDIO_RESAMPLER
	prompt "Audio resampler"
	default AUDIO_RESAMPLER_IDENTITY

config AUDIO_RESAMPLER_IDENTITY
	bool "Identity (memcpy passthrough)"

config AUDIO_RESAMPLER_ASRC_LINEAR
	bool "Linear ASRC"
endchoice

choice AUDIO_CLOCK_ACTUATOR
	prompt "Audio clock actuator"
	default AUDIO_CLOCK_ACTUATOR_NONE

config AUDIO_CLOCK_ACTUATOR_APLL
	bool "APLL (nRF5340 HFCLKAUDIO)"

config AUDIO_CLOCK_ACTUATOR_NONE
	bool "None (data-path only)"
endchoice

config AUDIO_DRIFT_OUTPUT_CLAMP
	int "Controller output clamp (±ppm)"
	default 500

config AUDIO_DRIFT_PHASE_INTEGRAL_CLAMP
	int "Phase integral clamp (±ppm)"
	default 500

source "Kconfig.zephyr"
