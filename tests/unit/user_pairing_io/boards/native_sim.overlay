 *
 * P2 test overlay (native_sim): one gpio-keys button on gpio0 pin 1
 * (pull-up, active-low) and one active-low gpio-leds LED on gpio0 pin 2,
 * wired through the user-button / user-led aliases.  The stock native_sim
 * leds node (pin 0) is untouched.  The gpio-keys debounce interval is the
 * suite value (30 ms) and is BUILD_ASSERTed equal to
 * CONFIG_USER_PAIRING_DEBOUNCE_MS in the production source.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	user-gpio-keys {
		compatible = "gpio-keys";
		debounce-interval-ms = <30>;

		user_button_node: button_0 {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	user-leds {
		compatible = "gpio-leds";

		user_led_node: led_user {
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		};
	};

	aliases {
		user-button = &user_button_node;
		user-led = &user_led_node;
	};
};
