mainmenu "LE Audio Receiver (nRF5340 + PCM5102A)"

config INFO_REPORTING_INTERVAL
	int "Number of SDUs between log reports"
	default 0
	help
	  Set to 0 to disable periodic logging to avoid UART spam.

config BT_AUDIO_VOL_DEFAULT
	int "Default VCP volume level (0-255)"
	default 195
	range 0 255
	depends on BT_VCP_VOL_REND
	help
	  Initial volume applied by the VCP Volume Renderer at startup.
	  195 is approximately 76% of full scale.

choice AUDIO_CLOCK_ACTUATOR
	prompt "Audio clock actuator"
	default AUDIO_CLOCK_ACTUATOR_APLL

config AUDIO_CLOCK_ACTUATOR_APLL
	bool "APLL (nRF5340 HFCLKAUDIO)"
	help
	  Use the nRF5340 HFCLKAUDIO APLL for clock steering.
	  ppm → APLL register trim.

config AUDIO_CLOCK_ACTUATOR_NONE
	bool "None (no actuator)"
	help
	  No clock actuator. Controller runs but output is discarded.
	  For testing on platforms without a clock steering mechanism.

config AUDIO_CLOCK_ACTUATOR_SAMPLE_ADJUST
	bool "Sample insert/drop (nRF54L15)"
	help
	  Compensate clock drift by inserting or dropping single PCM samples
	  in the I2S output block. Degenerate ASRC (nearest-neighbor). For
	  platforms without a steerable audio clock (nRF54L15).
endchoice

source "Kconfig.zephyr"
