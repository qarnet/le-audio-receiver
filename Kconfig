mainmenu "LE Audio Receiver"

config INFO_REPORTING_INTERVAL
	int "Number of SDUs between log reports"
	default 0
	help
	  Set to 0 to disable periodic logging to avoid UART spam.

config BT_AUDIO_VOL_DEFAULT
	int "Default VCP volume level (0-255)"
	default 195
	range 0 255
	depends on BT_VCP_VOL_REND
	help
	  Initial volume applied by the VCP Volume Renderer at startup.
	  195 is approximately 76% of full scale.

config AUDIO_I2S_OUTPUT_SAMPLE_RATE_HZ
	int "Actual I2S output sample rate"
	default 48000
	range 1 192000
	help
	  Actual I2S LRCK frequency in Hz. The hardware divider may not
	  produce exactly 48000 (e.g. PCLK32M gives ~47619). Set this to
	  the measured hardware rate so the rate converter can match
	  decoder output to drain rate. The I2S config frame_clk_freq
	  stays at 48000 (the nominal requested rate).

config AUDIO_I2S_WRITE_TIMEOUT_MS
	int "I2S TX write timeout (ms)"
	default 0
	range 0 100
	help
	  This value bounds two independent backpressure points. The
	  struct i2s_config.timeout field bounds one i2s_write() when the TX
	  descriptor queue is full. Primary PCM slab allocation uses this
	  timeout only after DMA START and only in the started path. 0 means
	  no wait. Startup pre-fill and repeat fallback slab allocations always
	  use no wait. K_FOREVER is never used.

choice AUDIO_RESAMPLER
	prompt "Audio resampler"
	default AUDIO_RESAMPLER_IDENTITY
	help
	  Data-path resampler between decoder output (48 kHz) and I2S
	  drain.  Must be paired with a compatible AUDIO_CLOCK_ACTUATOR:
	    IDENTITY     → APLL  (nRF5340 production)
	    ASRC_LINEAR  → NONE  (nRF54L15 production, ASRC consumes ppm)

config AUDIO_RESAMPLER_IDENTITY
	bool "Identity (memcpy passthrough)"
	help
	  memcpy pass-through.  On nRF5340 the APLL steers the audio
	  clock so no data-path resampling is needed.

config AUDIO_RESAMPLER_ASRC_LINEAR
	bool "Linear ASRC"
	help
	  Stateful cross-block fixed-point linear-interpolation stereo
	  ASRC.  Consumes drift-controller ppm as source_step correction.
	  Production path for nRF54L15.  Must pair with
	  AUDIO_CLOCK_ACTUATOR_NONE (ASRC handles the data path; no
	  physical actuator exists on this platform).
endchoice

choice AUDIO_CLOCK_ACTUATOR
	prompt "Audio clock actuator"
	default AUDIO_CLOCK_ACTUATOR_APLL

config AUDIO_CLOCK_ACTUATOR_APLL
	bool "APLL (nRF5340 HFCLKAUDIO)"
	help
	  HFCLKAUDIO APLL register trim.  ppm → register write.
	  Pair with AUDIO_RESAMPLER_IDENTITY (nRF5340 production).

config AUDIO_CLOCK_ACTUATOR_NONE
	bool "None (data-path only)"
	help
	  No physical clock actuator.  Controller ppm is consumed by the
	  data-path resampler (ASRC_LINEAR).  Used on nRF54L15.
endchoice

config AUDIO_DRIFT_OUTPUT_CLAMP
	int "Controller output clamp (±ppm)"
	default 500
	range 1 3000
	help
	  Maximum absolute ppm output from the PI clock recovery controller.
	  Default 500 ppm for nRF5340 APLL (steps ≈3.3 ppm, range
	  ≈±600 ppm around centre).  Set to 2000 on nRF54L15 (ASRC or
	  SAMPLE_ADJUST; paired with AUDIO_DRIFT_PHASE_INTEGRAL_CLAMP
	  for headroom around the measured PCLK offset).

config AUDIO_DRIFT_PHASE_INTEGRAL_CLAMP
	int "Phase integral clamp (±ppm)"
	default 500
	range 1 2000
	help
	  Maximum absolute ppm the phase integral term can contribute.
	  Default 500 ppm preserves existing nRF5340 behaviour.
	  Recommended 150–200 ppm on nRF54L15 so phase authority does not
	  consume all headroom around the measured PCLK offset.

config AUDIO_PERF_MEASUREMENT
	bool "Audio performance instrumentation"
	default n
	help
	  Low-overhead cycle and queue measurement for LC3 decode, volume,
	  sink push, and ISO receive paths.  Compiles to static inline
	  no-ops when disabled.  Exposed through "audio perf" shell command.

config AUDIO_PERF_DEADLINE_US
	int "Per-path deadline threshold in microseconds"
	default 10000
	depends on AUDIO_PERF_MEASUREMENT
	help
	  Deadline for per-path overrun counting.  Converted to CPU cycles
	  at runtime via k_us_to_cyc_ceil32().  Default 10000 us = 10 ms.
	  Works correctly across all platforms and native_sim.

config AUDIO_ACCEPTANCE_DIAGNOSTICS
	bool "FLPR acceptance diagnostics shell commands"
	default n
	depends on SOC_NRF54L15 && SHELL
	help
	  Gate the FLPR acceptance-harness shell commands (flpr ring *,
	  flpr stress, flpr hang) behind an explicit diagnostics option so
	  normal audio diagnostics never compile the acceptance harness.
	  Enabled only in boards/nrf54l15dk_nrf54l15_cpuapp.conf; the
	  nRF5340 target has no FLPR acceptance commands.  The FLPR-image
	  fault-handler gating is the separate
	  CONFIG_FLPR_ACCEPTANCE_DIAGNOSTICS option.

config HIL_BAP_ENABLE_TRACE
	bool "HIL BAP enable callback trace"
	default n
	depends on SOC_NRF54L15 && BT && LOG
	help
	  Temporary nRF54L15 HIL-only marker after the receiver stream enabled
	  callback returns from bt_bap_stream_start(). It records the stream slot
	  and return code for one pre-stream diagnostic branch. Keep disabled in
	  normal builds. It does not establish peer delivery, a root cause, or a
	  production repair.

config HIL_HCI_REMOVE_ISO_PATH_TRACE
	bool "HIL callback-timed HCI Remove ISO Path trace"
	default n
	depends on SOC_NRF54L15 && BT && LOG_RUNTIME_FILTERING
	help
	  Temporary HIL-only diagnostic. Arms the bt_hci_core and
	  bt_sdc_hci_driver runtime log sources at lc3_disable(). Keep this
	  option disabled in normal builds.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE
	bool "Temporary HIL-only SDC LE Remove ISO Data Path wrapper trace"
	default n
	depends on SOC_NRF54L15 && BT && BT_ISO && LOG
	depends on !HIL_HCI_REMOVE_ISO_PATH_TRACE
	help
	  Temporary HIL-only diagnostic. Wrap the SDC LE Remove ISO Data Path
	  call and emit low-volume entry and return markers for nRF54L15 HIL.
	  Keep this option disabled in normal builds. It cannot coexist with
	  the callback-timed HCI Remove ISO Path trace.

choice HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_PROBE
	prompt "SDC LE Remove ISO Data Path trace probe"
	default HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_WORK_STATE_SNAPSHOT
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_WORK_STATE_SNAPSHOT
	bool "Work-state snapshot"
	help
	  Preserve the delayed MPSL work-state snapshot used by the existing
	  callback-timed HIL trace.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_SCHEDULER_UNLOCK
	bool "Scheduler unlock"
	help
	  Record the sender thread after target receive-work submission and
	  trace its next scheduler unlock. The state marker records only MPSL
	  work-queue switch-ins observed while control is inside that exact
	  wrapped unlock window. A positive switch count does not prove that
	  the receive handler fetched the command. This probe must not schedule
	  any additional work.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_RECEIVE_DISPOSITION
	bool "Receive disposition"
	help
	  Temporary HIL-only diagnostic. Record target-owned receive disposition
	  in the MPSL receive work context, without making a root-cause claim.
	  Normal builds keep this diagnostic disabled.
endchoice

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME
	bool "ISO RX lifetime"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_RECEIVE_DISPOSITION
	depends on !NET_BUF_LOG
	help
	  Temporary nRF54L15 HIL-only diagnostic. Track host ISO RX
	  allocation and final-release occupancy. Requires the receive-
	  disposition trace and relies on ordinary net_buf_unref linkage, so
	  NET_BUF_LOG must remain off. Normal builds keep this diagnostic
	  disabled.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_DISPOSITION
	bool "ISO RX lifetime disposition"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME
	help
	  Temporary nRF54L15 HIL-only diagnostic. Record bounded host-dispatch
	  and app-callback progression for tracked ISO RX buffers at lifetime
	  snapshots. Wrap internal bt_conn_recv only for this exact NCS build.
	  This does not establish buffer ownership or queue location. Normal
	  builds keep this diagnostic disabled.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH
	bool "ISO RX lifetime TX-notify flush progression"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_DISPOSITION
	help
	  Temporary nRF54L15 HIL-only diagnostic. Observe k_work_flush()
	  while an HIL diagnostic bt_conn_recv() context is live for tracked
	  ISO RX buffers. This does not establish a work owner, blocking cause,
	  or repair. Normal builds keep this diagnostic disabled.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH_SEMAPHORE
	bool "ISO RX lifetime TX-notify flush semaphore progression"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH
	help
	  Temporary nRF54L15 HIL-only diagnostic. Observe entry and return of the
	  exact matching generated z_impl_k_sem_take() reached by the scoped
	  k_work_flush() call. This does not establish that the semaphore pended,
	  identify work ownership, or authorize a repair. Normal builds keep this
	  diagnostic disabled.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH_SEMAPHORE_PEND
	bool "ISO RX lifetime TX-notify flush semaphore pend progression"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH_SEMAPHORE
	help
	  Temporary nRF54L15 HIL-only diagnostic. Observe entry and return of the
	  exact matching z_pend_curr() wait queue selected after the scoped flusher
	  semaphore path. This does not establish a completed pend, work owner,
	  blocking cause, deadlock, or a production repair. Normal builds keep this
	  diagnostic disabled.

config HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH_SEMAPHORE_PEND_SCHED_GIVE
	bool "ISO RX lifetime TX-notify flush semaphore pend scheduler and give progression"
	default n
	depends on HIL_SDC_HCI_REMOVE_ISO_PATH_TRACE_ISO_RX_LIFETIME_TX_NOTIFY_FLUSH_SEMAPHORE_PEND
	depends on TRACING_USER
	depends on TRACING_THREAD
	help
	  Temporary nRF54L15 HIL-only diagnostic. Observe only the H38-scoped user
	  scheduler-pend hook after a thread is marked pending, plus entry to the
	  exact captured flusher semaphore's generated give implementation. This
	  explicitly excludes wait-queue insertion, work ownership or execution,
	  wake completion, root cause, and repair claims. Normal builds keep this
	  diagnostic disabled.

# ── FLPR ASRC offload ──────────────────────────────────────────────

config AUDIO_OFFLOAD_ASRC
	bool "FLPR ASRC offload (nRF54L15 only)"
	default y
	depends on AUDIO_RESAMPLER_ASRC_LINEAR && SOC_NRF54L15
	help
	  Route decoded PCM through FLPR ASRC processing.  On success the
	  FLPR-processed output replaces the cpuapp ASRC; on any fault
	  the cpuapp ASRC runs as fallback with no audio drop.

	  Requires CONFIG_SOC_NRF54L15 + AUDIO_RESAMPLER_ASRC_LINEAR.
	  Compiles out on nRF5340.

config AUDIO_OFFLOAD_ASRC_VERIFY
	bool "Shadow-verify FLPR ASRC against cpuapp ASRC"
	default n
	depends on AUDIO_OFFLOAD_ASRC
	help
	  After every FLPR ASRC round trip, run the identical cpuapp
	  ASRC from the same pre-state and ppm input into a static
	  481-frame buffer, then compare return code, frame count,
	  every sample, and post-state.

	  Mismatch records a verify fault, poisons offload, and returns
	  error with caller output untouched.  This adds ~1924 bytes of
	  static buffer and one cpuapp ASRC call per 10 ms block (≈13 klx
	  of fixed-point arithmetic).

	  Production builds must disable this option.  Development and
	  acceptance testing enable it for cross-validation.

config AUDIO_MODEA_MAX_FRAME_OCTETS
	int "Mode A pending frame block size (octets per mono frame)"
	default 120
	range 20 240
	help
	  Bounded compressed-SDU buffer size for one Mode A half frame
	  block held pending by the Mode A event assembler (audio_modea).
	  The receiver advertises 20..120 octets per frame at 48 kHz and
	  rejects any larger validated shape, so 120 covers every accepted
	  Mode A mono configuration; the range ceiling exists only so the
	  option can be raised without a code change.

config AUDIO_MODEA_PENDING_DEPTH
	int "Mode A pending halves per channel (fixed-depth queue)"
	default 2
	range 1 4
	help
	  Maximum unresolved half events buffered per Mode A channel by
	  the event assembler.  Depth 2 covers the measured <=1-event
	  cross-CIS callback skew plus single-SDU losses and a one-event
	  loss burst on one channel while the other keeps delivering.  A
	  third concurrent unresolved event on one channel (the other
	  channel stalled >=2 events) overflows: the oldest entry is
	  dropped and counted in the assembler stats (never silent).
	  Bounded static state; no heap.

config AUDIO_ISO_SEQ_MAX_CONCEAL
	int "Per-CIS omission concealment bound (omitted SDUs/events per delivered callback)"
	default 8
	range 1 64
	help
	  Shared bound for sequence- and timestamp-detected ISO omissions:
	  maximum SDUs/events concealed as PLC per delivered callback when
	  the ISO stack omits callbacks for lost events (observed on the
	  nRF5340 SW Split controller: no VALID and no LOST callback for
	  some lost events).  audio_iso_seq tracks each CIS's delivered
	  HCI packet sequence numbers and reports the omitted count when
	  the next callback's Packet_Sequence_Number jumps; audio_iso_cadence
	  tracks delivered ISO timestamps and reports the omitted count
	  when the timestamp advances by more than the SDU interval.  The
	  timestamp-cadence grid classification uses a clock/span-scaled
	  tolerance, not a fixed value: a 32 us base (one 32768 Hz tick
	  plus capture quantization) plus a combined worst-case SCA drift
	  budget (1000 ppm) over the spanned events, capped at a quarter
	  interval so the nearest-integer event count can never approach
	  half-interval ambiguity.  Note
	  that HCI packet sequence can stay CONTIGUOUS for controller-side
	  omission: SW Split advances its session sequence number only when
	  an SDU is emitted to the host, so a radio event with no received
	  PDU emits no HCI SDU and consumes no sequence number (FR4 mono
	  evidence: 12000 SDUs transmitted, 8876 callbacks, zero sequence
	  gaps, 225 I2S restarts).  The receive path conceals up to this
	  many omitted events as PLC before processing the current SDU,
	  taking the MAX of the sequence- and timestamp-derived counts so
	  one physical omission is never concealed twice, and keeping I2S
	  output cadence.

	  8 omitted SDUs = 80 ms at 10 ms frames, half the 16-block I2S
	  slab budget (~160 ms), so a bound-sized gap still fits the
	  audio buffering while the drift controller re-converges.  A
	  forward jump beyond this bound is treated as a discontinuity:
	  the trackers resync and the receive path logs the evidence
	  instead of synthesizing unbounded work (duplicates, backward
	  sequences, timestamp wraps are likewise explicit resync/wrap
	  outcomes).

# ── User pairing control (P1): portable pairing-mode transition owner ──

config USER_PAIRING_CONTROL
	bool "User pairing control (pairing-mode transition owner)"
	default n
	select EVENTS
	help
	  Portable NORMAL/BONDING/RESETTING transition owner
	  (src/pairing_mode.c).  Production boards enable this only when
	  the full feature stack (input/LED adapter, Bluetooth adapter,
	  lifecycle/shell integration) is wired — see
	  docs/development/user-pairing-control-plan.md.  P1 keeps every
	  production board config disabled.

config USER_PAIRING_BOND_HOLD_MS
	int "BONDING button-hold threshold (ms)"
	default 3000
	range 1 60000
	depends on USER_PAIRING_CONTROL
	help
	  Debounced button hold duration that requests BONDING.  Consumed
	  by the P2 input adapter; defined here so the relational timing
	  BUILD_ASSERTs (reset threshold > bonding threshold) can live in
	  the P1 controller.

config USER_PAIRING_RESET_HOLD_MS
	int "RESET button-hold threshold (ms)"
	default 8000
	range 1 120000
	depends on USER_PAIRING_CONTROL
	help
	  Debounced button hold duration that requests RESET.  Consumed
	  by the P2 input adapter; must exceed USER_PAIRING_BOND_HOLD_MS
	  (BUILD_ASSERT in src/pairing_mode.c).

config USER_PAIRING_BOND_LED_HALF_PERIOD_MS
	int "BONDING LED half-period (ms)"
	default 500
	range 1 60000
	depends on USER_PAIRING_CONTROL
	help
	  BONDING LED toggle interval: immediately active on entry, then
	  one toggle per half-period.

config USER_PAIRING_RESET_LED_HALF_PERIOD_MS
	int "RESET LED half-period (ms)"
	default 100
	range 1 60000
	depends on USER_PAIRING_CONTROL
	help
	  RESET feedback LED toggle interval.  USER_PAIRING_RESET_FEEDBACK_MS
	  must be divisible by this value with a quotient of at least two
	  (BUILD_ASSERT in src/pairing_mode.c).

config USER_PAIRING_RESET_FEEDBACK_MS
	int "RESET feedback indication duration (ms)"
	default 1000
	range 1 60000
	depends on USER_PAIRING_CONTROL
	help
	  Duration of the rapid LED indication after bonds are deleted and
	  before BONDING advertising starts.  At the production defaults
	  (1000 ms / 100 ms half-period) this produces five complete rapid
	  flashes.

config USER_PAIRING_WORKQ_STACK_SIZE
	int "Pairing-mode work-queue stack size (bytes)"
	default 2048
	range 1024 32768
	depends on USER_PAIRING_CONTROL
	help
	  Stack for the controller's private work queue thread.

config USER_PAIRING_WORKQ_PRIORITY
	int "Pairing-mode work-queue thread priority"
	default 5
	range 0 15
	depends on USER_PAIRING_CONTROL
	help
	  Priority of the controller's private work queue thread (lower
	  number = higher priority).

# ── User pairing control (P2): generic input and LED adapter ─────────

config USER_PAIRING_INPUT
	bool "User button and LED pairing control"
	default n
	depends on USER_PAIRING_CONTROL && INPUT
	depends on DT_HAS_GPIO_KEYS_ENABLED
	select GPIO
	help
	  Reusable user-button / user-LED pairing-control adapter
	  (src/user_pairing_io.c).  Hardware is selected only through the
	  'user-button' (child of a gpio-keys node) and 'user-led' (gpio-leds
	  child) devicetree aliases; no board-number conditionals.  The
	  gpio-keys driver owns debounce; this module schedules/cancels the
	  BONDING/RESET hold thresholds and forwards them to pairing_mode.
	  Production boards enable this only when the full feature stack is
	  wired — see docs/development/user-pairing-control-plan.md.  P2
	  keeps every production board config disabled.

config USER_PAIRING_DEBOUNCE_MS
	int "User pairing button debounce interval"
	default 30
	range 1 1000
	depends on USER_PAIRING_INPUT
	help
	  Board/devicetree contract value: the selected gpio-keys node's
	  resolved debounce-interval-ms must equal this value (BUILD_ASSERT
	  in src/user_pairing_io.c).  The gpio-keys driver implements the
	  debounce; this module adds no second debounce timer.

config USER_PAIRING_SHELL_RESET_TIMEOUT_MS
	int "Pairing reset shell timeout (ms)"
	default 15000
	range 1000 120000
	depends on USER_PAIRING_INPUT && SHELL
	help
	  Bounded synchronous wait for the 'bt unpair' RESET transition
	  (disconnect + 1-second feedback + BONDING advertising completion)
	  with ample controller margin.  On timeout the shell prints an
	  error and the transition continues asynchronously; success is
	  printed only after BONDING advertising is active.

source "Kconfig.zephyr"
