mainmenu "LE Audio Receiver"

config INFO_REPORTING_INTERVAL
	int "Number of SDUs between log reports"
	default 0
	help
	  Set to 0 to disable periodic logging to avoid UART spam.

config BT_AUDIO_VOL_DEFAULT
	int "Default VCP volume level (0-255)"
	default 195
	range 0 255
	depends on BT_VCP_VOL_REND
	help
	  Initial volume applied by the VCP Volume Renderer at startup.
	  195 is approximately 76% of full scale.

config AUDIO_I2S_OUTPUT_SAMPLE_RATE_HZ
	int "Actual I2S output sample rate"
	default 48000
	range 1 192000
	help
	  Actual I2S LRCK frequency in Hz. The hardware divider may not
	  produce exactly 48000 (e.g. PCLK32M gives ~47619). Set this to
	  the measured hardware rate so the rate converter can match
	  decoder output to drain rate. The I2S config frame_clk_freq
	  stays at 48000 (the nominal requested rate).

choice AUDIO_RESAMPLER
	prompt "Audio resampler"
	default AUDIO_RESAMPLER_IDENTITY
	help
	  Data-path resampler between decoder output (48 kHz) and I2S
	  drain.  Must be paired with a compatible AUDIO_CLOCK_ACTUATOR:
	    IDENTITY     → APLL  (nRF5340 production)
	    ASRC_LINEAR  → NONE  (nRF54L15 production, ASRC consumes ppm)

config AUDIO_RESAMPLER_IDENTITY
	bool "Identity (memcpy passthrough)"
	help
	  memcpy pass-through.  On nRF5340 the APLL steers the audio
	  clock so no data-path resampling is needed.

config AUDIO_RESAMPLER_ASRC_LINEAR
	bool "Linear ASRC"
	help
	  Stateful cross-block fixed-point linear-interpolation stereo
	  ASRC.  Consumes drift-controller ppm as source_step correction.
	  Production path for nRF54L15.  Must pair with
	  AUDIO_CLOCK_ACTUATOR_NONE (ASRC handles the data path; no
	  physical actuator exists on this platform).
endchoice

choice AUDIO_CLOCK_ACTUATOR
	prompt "Audio clock actuator"
	default AUDIO_CLOCK_ACTUATOR_APLL

config AUDIO_CLOCK_ACTUATOR_APLL
	bool "APLL (nRF5340 HFCLKAUDIO)"
	help
	  HFCLKAUDIO APLL register trim.  ppm → register write.
	  Pair with AUDIO_RESAMPLER_IDENTITY (nRF5340 production).

config AUDIO_CLOCK_ACTUATOR_NONE
	bool "None (data-path only)"
	help
	  No physical clock actuator.  Controller ppm is consumed by the
	  data-path resampler (ASRC_LINEAR).  Used on nRF54L15.
endchoice

config AUDIO_DRIFT_OUTPUT_CLAMP
	int "Controller output clamp (±ppm)"
	default 500
	range 1 3000
	help
	  Maximum absolute ppm output from the PI clock recovery controller.
	  Default 500 ppm for nRF5340 APLL (steps ≈3.3 ppm, range
	  ≈±600 ppm around centre).  Set to 2000 on nRF54L15 (ASRC or
	  SAMPLE_ADJUST; paired with AUDIO_DRIFT_PHASE_INTEGRAL_CLAMP
	  for headroom around the measured PCLK offset).

config AUDIO_DRIFT_PHASE_INTEGRAL_CLAMP
	int "Phase integral clamp (±ppm)"
	default 500
	range 1 2000
	help
	  Maximum absolute ppm the phase integral term can contribute.
	  Default 500 ppm preserves existing nRF5340 behaviour.
	  Recommended 150–200 ppm on nRF54L15 so phase authority does not
	  consume all headroom around the measured PCLK offset.

config AUDIO_PERF_MEASUREMENT
	bool "Audio performance instrumentation"
	default n
	help
	  Low-overhead cycle and queue measurement for LC3 decode, volume,
	  sink push, and ISO receive paths.  Compiles to static inline
	  no-ops when disabled.  Exposed through "audio perf" shell command.

config AUDIO_PERF_DEADLINE_US
	int "Per-path deadline threshold in microseconds"
	default 10000
	depends on AUDIO_PERF_MEASUREMENT
	help
	  Deadline for per-path overrun counting.  Converted to CPU cycles
	  at runtime via k_us_to_cyc_ceil32().  Default 10000 us = 10 ms.
	  Works correctly across all platforms and native_sim.

config AUDIO_ACCEPTANCE_DIAGNOSTICS
	bool "FLPR acceptance diagnostics shell commands"
	default n
	depends on SOC_NRF54L15 && SHELL
	help
	  Gate the FLPR acceptance-harness shell commands (flpr ring *,
	  flpr stress, flpr hang) behind an explicit diagnostics option so
	  normal audio diagnostics never compile the acceptance harness.
	  Enabled only in boards/nrf54l15dk_nrf54l15_cpuapp.conf; the
	  nRF5340 target has no FLPR acceptance commands.  The FLPR-image
	  fault-handler gating is separate CONFIG_FLPR_ACCEPTANCE_DIAGNOSTICS
	  work (R8).

# ── Stage 3B: FLPR ASRC offload ─────────────────────────────────────

config AUDIO_OFFLOAD_ASRC
	bool "FLPR ASRC offload (nRF54L15 only)"
	default y
	depends on AUDIO_RESAMPLER_ASRC_LINEAR && SOC_NRF54L15
	help
	  Route decoded PCM through FLPR ASRC processing.  On success the
	  FLPR-processed output replaces the cpuapp ASRC; on any fault
	  the cpuapp ASRC runs as fallback with no audio drop.

	  Requires CONFIG_SOC_NRF54L15 + AUDIO_RESAMPLER_ASRC_LINEAR.
	  Compiles out on nRF5340.

config AUDIO_OFFLOAD_ASRC_VERIFY
	bool "Shadow-verify FLPR ASRC against cpuapp ASRC"
	default n
	depends on AUDIO_OFFLOAD_ASRC
	help
	  After every FLPR ASRC round trip, run the identical cpuapp
	  ASRC from the same pre-state and ppm input into a static
	  481-frame buffer, then compare return code, frame count,
	  every sample, and post-state.

	  Mismatch records a verify fault, poisons offload, and returns
	  error with caller output untouched.  This adds ~1924 bytes of
	  static buffer and one cpuapp ASRC call per 10 ms block (≈13 klx
	  of fixed-point arithmetic).

	  Production builds must disable this option.  Development and
	  acceptance testing enable it for cross-validation.

config AUDIO_MODEA_MAX_FRAME_OCTETS
	int "Mode A pending frame block size (octets per mono frame)"
	default 120
	range 20 240
	help
	  Bounded compressed-SDU buffer size for one Mode A half frame
	  block held pending by the Mode A event assembler (audio_modea).
	  The receiver advertises 20..120 octets per frame at 48 kHz and
	  rejects any larger validated shape, so 120 covers every accepted
	  Mode A mono configuration; the range ceiling exists only so the
	  option can be raised without a code change.

config AUDIO_MODEA_PENDING_DEPTH
	int "Mode A pending halves per channel (fixed-depth queue)"
	default 2
	range 1 4
	help
	  Maximum unresolved half events buffered per Mode A channel by
	  the event assembler.  Depth 2 covers the measured <=1-event
	  cross-CIS callback skew plus single-SDU losses and a one-event
	  loss burst on one channel while the other keeps delivering.  A
	  third concurrent unresolved event on one channel (the other
	  channel stalled >=2 events) overflows: the oldest entry is
	  dropped and counted in the assembler stats (never silent).
	  Bounded static state; no heap.

config AUDIO_ISO_SEQ_MAX_CONCEAL
	int "Per-CIS sequence-gap concealment bound (omitted SDUs per callback)"
	default 8
	range 1 64
	help
	  Maximum SDUs concealed as PLC per delivered callback when the
	  ISO stack omits callbacks for lost SDUs (observed on the
	  nRF5340 SW Split controller: no VALID and no LOST callback for
	  some lost events; the next callback's Packet_Sequence_Number
	  then jumps).  audio_iso_seq tracks each CIS's delivered
	  sequences and reports the omitted count; the receive path
	  conceals up to this many omitted SDUs as PLC before processing
	  the current SDU, keeping I2S output cadence.

	  8 omitted SDUs = 80 ms at 10 ms frames, half the 16-block I2S
	  slab budget (~160 ms), so a bound-sized gap still fits the
	  audio buffering while the drift controller re-converges.  A
	  forward jump beyond this bound is treated as a discontinuity:
	  the tracker resyncs and the receive path logs the evidence
	  instead of synthesizing unbounded work (duplicates and
	  backward sequences are likewise explicit resync outcomes).

source "Kconfig.zephyr"
