/*
 * Copyright (c) 2025
 * SPDX-License-Identifier: Apache-2.0
 *
 * Seeed Xiao nRF54L15 overrides for the stock nrf54l15dk board target.
 * The Xiao's onboard SAMD11 CMSIS-DAP bridges UART20 (P1.9 TX / P1.8 RX)
 * to the USB CDC serial port. The stock DK uses P1.4/P1.5, so we remap
 * uart20 here to get console output over the Xiao's USB port.
 *
 * I2S20 pins: SCK=P1.4 (D0), LRCK=P1.5 (D1), SDOUT=P1.6 (D2).
 * These are the only three free Xiao header pins on GPIO port 1.
 * The previous assignment (P1.10/P1.11/P1.12) collided silently with
 * pwm20 (P1.10, enabled on the stock nrf54l15dk) and pdm20 (P1.12,
 * enabled via dmic_dev). Zephyr does not detect pinctrl overlaps —
 * last peripheral to init a contested pin wins, the loser silently
 * corrupts. P1.8/P1.9 are the UART20 lines to the SAMD11 USB bridge
 * and must stay untouched.
 *
 * PDM20 (onboard mic) is disabled — this is a sink-only receiver.
 */

/ {
	aliases {
		i2s-audio = &i2s20;
	};
};

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 8)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
			low-power-enable;
		};
	};

	i2s20_default: i2s20_default {
		group1 {
			psels = <NRF_PSEL(I2S_SCK_M,  1, 4)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 5)>,
				<NRF_PSEL(I2S_SDOUT,  1, 6)>;
		};
	};
};

&uart20 {
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2s20 {
	status = "okay";
	pinctrl-0 = <&i2s20_default>;
	pinctrl-names = "default";
};

&pdm20 {
	status = "disabled";
};
