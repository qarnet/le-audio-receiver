/*
 * Copyright (c) 2025
 * SPDX-License-Identifier: Apache-2.0
 *
 * Seeed Xiao nRF54L15 overrides for the stock nrf54l15dk board target.
 * The Xiao's onboard SAMD11 CMSIS-DAP bridges UART20 (P1.9 TX / P1.8 RX)
 * to the USB CDC serial port. The stock DK uses P1.4/P1.5, so we remap
 * uart20 here to get console output over the Xiao's USB port.
 *
 * I2S20 pins: SCK=P1.4 (D0), LRCK=P1.5 (D1), SDOUT=P1.6 (D2).
 * These are the only three free Xiao header pins on GPIO port 1.
 * The previous assignment (P1.10/P1.11/P1.12) collided silently with
 * pwm20 (P1.10, enabled on the stock nrf54l15dk) and pdm20 (P1.12,
 * enabled via dmic_dev). Zephyr does not detect pinctrl overlaps —
 * last peripheral to init a contested pin wins, the loser silently
 * corrupts. P1.8/P1.9 are the UART20 lines to the SAMD11 USB bridge
 * and must stay untouched.
 *
 * PDM20 (onboard mic) is disabled — this is a sink-only receiver.
 */

/ {
	aliases {
		i2s-audio = &i2s20;
	};

	/*
	 * RF antenna switch for the Xiao nRF54L15 ceramic antenna.
	 * These fixed regulators drive the onboard RF switch:
	 *   rfsw_ctl: P2.05 active-low  → selects ceramic antenna
	 *   rfsw_pwr: P2.03 active-high → powers antenna path
	 * Without these, the antenna path is open and Bluetooth range
	 * collapses to ~ -96 dBm at 0.5 m (stock DK has no RF switch).
	 * Definitions match the official Seeed Xiao board.
	 */
	rfsw_ctl: rfsw-ctl {
		compatible = "regulator-fixed";
		regulator-name = "rfsw-ctl";
		enable-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
	};

	rfsw_pwr: rfsw-pwr {
		compatible = "regulator-fixed";
		regulator-name = "rfsw-pwr";
		enable-gpios = <&gpio2 3 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 8)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 9)>,
				<NRF_PSEL(UART_RX, 1, 8)>;
			low-power-enable;
		};
	};

	i2s20_default: i2s20_default {
		group1 {
			/* SCK_M, LRCK_M, SDOUT on Xiao D0/D1/D2.
			 * MCK routed to D3 (P1.7) even though the UDA1334A/PCM5102A
			 * DAC doesn't use it (internal PLL from BCK). The nRF54L15
			 * I2S peripheral needs a real MCK PSEL connected for the MCK
			 * generator to run and derive SCK/LRCK — without an MCK pin
			 * the master-mode transfer never progresses (DMA slab fills,
			 * no SCK/LRCK on the pins). D3 is a free Xiao header pin on
			 * the same GPIO port 1.
			 */
			psels = <NRF_PSEL(I2S_SCK_M,  1, 4)>,
				<NRF_PSEL(I2S_LRCK_M, 1, 5)>,
				<NRF_PSEL(I2S_SDOUT,  1, 6)>,
				<NRF_PSEL(I2S_MCK,    1, 7)>;
		};
	};
};

&uart20 {
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2s20 {
	status = "okay";
	/* nRF54L15 has no HFCLKAUDIO/APLL. The I2S MCK is derived from
	 * PCLK32M. Use the internal 32 MHz RC (HFINT) directly rather than
	 * PCLK32M_HFXO so the driver does not wait on an HFXO onoff
	 * request before starting the transfer — that onoff path never
	 * completes on this board (no LFCLK for the onoff manager before
	 * SDC is up) and TASKS_START never fires, leaving SCK/LRCK flat
	 * and the TX slab filling with undelivered buffers.
	 *
	 * Clock accuracy/jitter is HFINT-grade (RC, ~±250 ppm), which is
	 * fine for the ASRC drift actuator; an external
	 * low-jitter MCK is not wired on the Xiao.
	 */
	clock-source = "PCLK32M";
	pinctrl-0 = <&i2s20_default>;
	pinctrl-names = "default";
};

&pdm20 {
	status = "disabled";
};

/* Xiao has no external SPI NOR flash. Disable the stock-DK &mx25r64 and
 * its parent &spi00 (no other users) to silence the boot error:
 *   <err> spi_nor: Device id 00 00 00 does not match config c2 28 17
 *
 * TIMER20 (&timer20, reg = <0xca000 0x1000>) is reserved for direct HAL
 * use by audio_timing_nrf54.c: free-running PCLK timer, hardware-snapshotted
 * by GRTC compare→GPPI→TASKS_CAPTURE at 1-second intervals. The base DTS
 * defines it with status "disabled". Mark it "reserved" so no Zephyr counter
 * driver binds to it, but it remains addressable via DT_NODELABEL(timer20) /
 * DT_REG_ADDR for our HAL code.
 */
&timer20 {
	status = "reserved";
};

&mx25r64 {
	status = "disabled";
};

/*
 * FLPR IPC: ICMsg over VEVIF for cpuapp↔FLPR handshake.
 * Shared memory at 0x20028000..0x20030000 (32 KB between cpuapp and FLPR SRAM).
 * rx = 8 KB at 0x20028000, tx = 8 KB at 0x2002A000.
 * Must stay in sync with src/flpr/boards/*.overlay (swapped perspective).
 */
/ {
	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;

			sram_rx: memory@20028000 {
				reg = <0x20028000 0x2000>;
			};

			sram_tx: memory@2002A000 {
				reg = <0x2002A000 0x2000>;
			};

			/* Stage 1 PCM rings: 16 KiB at 0x2002C000.
			 * Split into two 8 KiB SPSC rings:
			 *   cpuapp_to_flpr_ring: 0x2002C000
			 *   flpr_to_cpuapp_ring: 0x2002E000
			 */
			pcm_ring: memory@2002C000 {
				reg = <0x2002C000 0x4000>;
			};
		};
	};

	ipc {
		ipc0: ipc0 {
			compatible = "zephyr,ipc-icmsg";
			dcache-alignment = <32>;
			tx-region = <&sram_tx>;
			rx-region = <&sram_rx>;
			mboxes = <&cpuapp_vevif_rx 20>, <&cpuapp_vevif_tx 21>;
			mbox-names = "rx", "tx";
			status = "okay";
		};
	};
};

&cpuapp_vevif_rx {
	status = "okay";
};

&cpuapp_vevif_tx {
	status = "okay";
};

&spi00 {
	status = "disabled";
};

/*
 * Xiao nRF54L15 uses 16 pF internal load capacitance for both LFXO
 * and HFXO. The stock DK settings (inherited from nrf54l15dk) are
 * 17 pF LFXO / 15 pF HFXO — wrong for the Xiao PCB.
 * Match the official Seeed Xiao board definition.
 */
&lfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <16000>;
	status = "okay";
};

&hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <16000>;
	status = "okay";
};
