 *
 * Override nordic-flpr snippet memory layout for nRF54L15.
 * Applied AFTER the snippet via sysbuild add_overlay_dts.
 *
 * Physical SRAM (256 KB at 0x20000000):
 *   0x20000000..0x20028000  cpuapp SRAM          (160 KB)
 *   0x20028000..0x20030000  shared IPC/ICMsg     ( 32 KB)
 *   0x20030000..0x20040000  FLPR execution SRAM  ( 64 KB)
 *
 * The nordic-flpr snippet defines cpuflpr_sram_code_data at 0x20028000
 * with 96 KB. Delete and redeclare it at 0x20030000 with 64 KB so the
 * shared IPC region is clear.
 */

/delete-node/ &cpuflpr_sram_code_data;

/ {
	reserved-memory {
		cpuflpr_code_partition: image@165000 {
			reg = <0x165000 DT_SIZE_K(96)>;
		};
	};

	soc {
		/delete-node/ reserved-memory;

		cpuflpr_sram_code_data: memory@20030000 {
			compatible = "mmio-sram";
			reg = <0x20030000 DT_SIZE_K(64)>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x20030000 0x10000>;
		};
	};
};

/* Ensure cpuapp_sram stays at 160 KB (ending before shared IPC). */
&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(160)>;
	ranges = <0x0 0x20000000 0x28000>;
};
