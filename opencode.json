{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/ncs/**": "allow",
      "/tmp/**": "allow",
      "/dev/**": "allow"
    }
  },
  "lsp": {
    "clangd": {
      "command": [
        "clangd",
        "--query-driver=/nix/store/**,/home/thomas-workstation/ncs/toolchains/*/opt/zephyr-sdk/**"
      ]
    }
  },
  "mcp": {
    "serial-mcp": {
      "enabled": true
    },
    "nordic-semiconductor-docs": {
      "enabled": true
    },
    "zephyr-docs": {
      "enabled": true
    }
  }
}
