{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/ncs/**": "allow",
      "/tmp/**": "allow",
      "/dev/**": "allow"
    }
  },
  "lsp": {
    "clangd": {
      "command": [
        "clangd",
        "--background-index",
        "--clang-tidy",
        "--query-driver=/home/thomas-win/ncs/toolchains/*/opt/zephyr-sdk/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc"
      ],
    }
  }
}
