{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "~/ncs/**": "allow",
      "/tmp/**": "allow",
      "/dev/**": "allow"
    }
  },
  "lsp": true,
  "mcp": {
    "brave-search": {
      "enabled": true
    },
    "serial-mcp": {
      "enabled": true
    },
    "codebase-memory-mcp": {
      "enabled": true
    },
    "nordic-semiconductor-docs": {
      "enabled": true
    },
    "zephyr-docs": {
      "enabled": true
    }
  }
}
