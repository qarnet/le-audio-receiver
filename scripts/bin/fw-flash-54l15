#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF54L15 firmware via OpenOCD (CMSIS-DAP, Xiao built-in probe).
#
# nRF54L15 RRAM needs no flash driver: with RRAMC write-enable set
# (mww 0x5004b500 0x101) it is plain byte-writable memory, so load_image
# suffices — that is exactly what Zephyr's xiao_nrf54l15 openocd.cfg
# `nrf54l-load` proc does. The same mechanism flashes FLPR firmware (the
# FLPR code partition is a RRAM slice at 0x165000 in the app core's
# address space) — verified 2026-07-05.
#
# The probe is auto-detected by target identity (fw-probes --find nrf54l).
#
# Build dir:  build/nrf54l15

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/nrf54l15"
HEX="$BUILD_DIR/merged.hex"
OPENOCD_CFG="$ZEPHYR_BASE/boards/seeed/xiao_nrf54l15/support/openocd.cfg"

if [ ! -f "$HEX" ]; then
  printf 'No build artifacts found at %s\n' "$HEX" >&2
  printf 'Build first: fw-build-54l15\n' >&2
  exit 1
fi

SERIAL="$("$SCRIPT_DIR/fw-probes" --find nrf54l)"
printf 'Probe %s (auto-detected: target identifies as nRF54L15)\n' "$SERIAL"

exec openocd \
  -c "adapter serial $SERIAL" \
  -f "$OPENOCD_CFG" \
  -c "init" \
  -c "reset halt" \
  -c "nrf54l-load $HEX" \
  -c "verify_image $HEX" \
  -c "reset run" \
  -c "shutdown"
