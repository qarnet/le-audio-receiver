#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF54L15 firmware via OpenOCD (CMSIS-DAP, Xiao built-in probe).
#
# nRF54L15 RRAM needs no flash driver: with RRAMC write-enable set
# (mww 0x5004b500 0x101) it is plain byte-writable memory, so load_image
# suffices — that is exactly what Zephyr's xiao_nrf54l15 openocd.cfg
# `nrf54l-load` proc does. The same mechanism flashes FLPR firmware (the
# FLPR code partition is a RRAM slice at 0x165000 in the app core's
# address space) — verified 2026-07-05.
#
# Flashes BOTH cpuapp and flpr images from the sysbuild
# multi-image layout (two separate hex files, each loaded at its encoded
# address).  There is no merged.hex path — the partition-manager fallback
# was removed; require both images.
#
# The probe is auto-detected by target identity (nrf-probes --find nrf54l)
# unless FW_NRF54L15_PROBE_SERIAL supplies a runner-resolved exact serial.
#
# Build dir:  build/nrf54l15

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/nrf54l15"
CPUAPP_HEX="$BUILD_DIR/le-audio-receiver/zephyr/zephyr.hex"
FLPR_HEX="$BUILD_DIR/flpr/zephyr/zephyr.hex"
OPENOCD_CFG="$ZEPHYR_BASE/boards/seeed/xiao_nrf54l15/support/openocd.cfg"

validate_hex_override() {
  local name="$1"
  local path="$2"
  local repo
  repo="$(realpath "$(_fw_repo_dir)")"

  if [ -z "$path" ]; then
    printf 'Invalid %s: empty path\n' "$name" >&2
    exit 1
  fi
  if [[ "$path" != /* ]]; then
    printf 'Invalid %s: path must be absolute\n' "$name" >&2
    exit 1
  fi
  if [ -L "$path" ] || [ ! -f "$path" ] || [ ! -s "$path" ]; then
    printf 'Invalid %s: must be a non-symlink nonempty regular file\n' "$name" >&2
    exit 1
  fi
  if [[ "$path" != *.hex ]]; then
    printf 'Invalid %s: path must end in .hex\n' "$name" >&2
    exit 1
  fi
  path="$(realpath "$path")"
  if [[ "$path" == "$repo" || "$path" == "$repo"/* ]]; then
    printf 'Invalid %s: path must be outside repository\n' "$name" >&2
    exit 1
  fi
  printf '%s\n' "$path"
}

CPUAPP_OVERRIDE="${FW_NRF54L15_CPUAPP_HEX:-}"
FLPR_OVERRIDE="${FW_NRF54L15_FLPR_HEX:-}"
if [ -n "$CPUAPP_OVERRIDE" ] || [ -n "$FLPR_OVERRIDE" ]; then
  if [ -z "$CPUAPP_OVERRIDE" ] || [ -z "$FLPR_OVERRIDE" ]; then
    printf 'FW_NRF54L15_CPUAPP_HEX and FW_NRF54L15_FLPR_HEX must be supplied together\n' >&2
    exit 1
  fi
  CPUAPP_HEX="$(validate_hex_override FW_NRF54L15_CPUAPP_HEX "$CPUAPP_OVERRIDE")"
  FLPR_HEX="$(validate_hex_override FW_NRF54L15_FLPR_HEX "$FLPR_OVERRIDE")"
fi

# Flashing requires both cpuapp and flpr images. Fail if either missing.
# Each hex is loaded at the address encoded in the file.
MISSING=""
[ -f "$CPUAPP_HEX" ] || MISSING="$MISSING cpuapp ($CPUAPP_HEX)"
[ -f "$FLPR_HEX"   ] || MISSING="$MISSING flpr ($FLPR_HEX)"
if [ -n "$MISSING" ]; then
  printf 'Missing build artifacts:%s\n' "$MISSING" >&2
  printf 'Build first: fw-build-54l15\n' >&2
  exit 1
fi

HEX_ARGS=(
  -c "nrf54l-load $CPUAPP_HEX"
  -c "verify_image $CPUAPP_HEX"
  -c "nrf54l-load $FLPR_HEX"
  -c "verify_image $FLPR_HEX"
)
printf 'Loading cpuapp + flpr hex images\n'

SERIAL="${FW_NRF54L15_PROBE_SERIAL:-}"
if [ -n "$SERIAL" ]; then
  if ! [[ "$SERIAL" =~ ^[[:alnum:]_.:-]+$ ]]; then
    printf 'Invalid FW_NRF54L15_PROBE_SERIAL %q: must match ^[[:alnum:]_.:-]+$\n' \
      "$SERIAL" >&2
    exit 1
  fi
  printf 'Probe %s (runner-resolved nRF54L15 identity)\n' "$SERIAL"
else
  SERIAL="$(nrf-probes --find nrf54l)"
  printf 'Probe %s (auto-detected: target identifies as nRF54L15)\n' "$SERIAL"
fi

exec openocd \
  -c "adapter serial $SERIAL" \
  -f "$OPENOCD_CFG" \
  -c "init" \
  -c "reset halt" \
  "${HEX_ARGS[@]}" \
  -c "reset run" \
  -c "shutdown"
