#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF54L15 firmware via probe-rs (CMSIS-DAP).
#
# probe-rs was evaluated 2026-07-05: reliable on the nRF54L15 (single core,
# no soft-APPROTECT trap — unlike the nRF5340, where probe-rs must NOT be
# used; see AGENTS.md). Fallback: openocd -f target/nordic/nrf54l.cfg.
#
# The probe is auto-detected by target identity (fw-probes --find nrf54l).
#
# Build dir:  build/nrf54l15

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/nrf54l15"
HEX="$BUILD_DIR/merged.hex"

if ! command -v probe-rs >/dev/null 2>&1; then
  printf 'fw-flash-54l15: probe-rs not found on PATH\n' >&2
  exit 1
fi

if [ ! -f "$HEX" ]; then
  printf 'No build artifacts found at %s\n' "$HEX" >&2
  printf 'Build first: fw-build-54l15\n' >&2
  exit 1
fi

SERIAL="$("$SCRIPT_DIR/fw-probes" --find nrf54l)"

# probe-rs selects probes as VID:PID:SERIAL — resolve VID:PID from sysfs.
VIDPID=""
for d in /sys/bus/usb/devices/*/; do
  if [ -f "$d/serial" ] && [ "$(cat "$d/serial")" = "$SERIAL" ]; then
    VIDPID="$(cat "$d/idVendor"):$(cat "$d/idProduct")"
    break
  fi
done
if [ -z "$VIDPID" ]; then
  printf 'fw-flash-54l15: probe %s not found in sysfs\n' "$SERIAL" >&2
  exit 1
fi

printf 'Probe %s:%s (auto-detected: target identifies as nRF54L15)\n' "$VIDPID" "$SERIAL"
probe-rs download --chip nRF54L15 --probe "$VIDPID:$SERIAL" \
  --binary-format hex "$HEX" "$@"
exec probe-rs reset --chip nRF54L15 --probe "$VIDPID:$SERIAL"
