#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF5340DK "dongle" firmware (hci_uart app core + hci_ipc net
# core) via OpenOCD and the DK's onboard J-Link.
#
# Both cores are programmed explicitly (net core first, then app core) so
# the ordering is deterministic — same sequence used during bring-up.
# UICR.APPROTECT is not touched here: the nRF5340DK ships with APPROTECT
# disabled by default and this firmware never re-enables it. If debug
# access is ever lost, run an nrf53 CTRL-AP recovery (mass erase) and
# reflash.
#
# Probe selection:
#   Default: OpenOCD J-Link auto-detection (the DK's onboard Segger J-Link).
#   Override: FW_DONGLE_JLINK_SERIAL=<jlink-serial> fw-flash-dongle selects
#   one specific J-Link by serial (validated against ^[[:alnum:]_.:-]+$).
#
# scripts/probe-serial.local and nrf-probes select CMSIS-DAP receiver
# targets and are NOT used for the dongle — it is programmed over the DK's
# onboard J-Link.
#
# Build dir:  build/dongle
# Build with: fw-build-dongle

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/dongle"
APP_HEX="$BUILD_DIR/hci_uart/zephyr/zephyr.hex"
NET_HEX="$BUILD_DIR/hci_ipc/zephyr/zephyr.hex"

if [ ! -f "$APP_HEX" ] || [ ! -f "$NET_HEX" ]; then
	printf 'No build artifacts found under %s\n' "$BUILD_DIR" >&2
	printf 'Build first: fw-build-dongle\n' >&2
	exit 1
fi

# Probe selection: default to OpenOCD J-Link auto-detection.  An explicit
# session-local override (FW_DONGLE_JLINK_SERIAL) selects one J-Link by
# serial; it is validated before OpenOCD is started.
JLINK_SERIAL="${FW_DONGLE_JLINK_SERIAL:-}"
if [ -n "$JLINK_SERIAL" ]; then
	if ! [[ "$JLINK_SERIAL" =~ ^[[:alnum:]_.:-]+$ ]]; then
		printf 'Invalid FW_DONGLE_JLINK_SERIAL %q: must match ^[[:alnum:]_.:-]+$\n' \
			"$JLINK_SERIAL" >&2
		exit 1
	fi
	printf 'Using J-Link override (serial %s)\n' "$JLINK_SERIAL"
else
	printf 'Using J-Link auto-detection\n'
fi

# NOTE: openocd -f interface/jlink.cfg (the DK's onboard J-Link), not
# cmsis-dap. The nRF5340DK ships with a Segger J-Link interface MCU.
# Build the argv as an array so the optional serial -c argument is a
# single argv element (no fragile IFS word-splitting).
OPENOCD_ARGS=(
	-f interface/jlink.cfg
	-c "transport select swd"
	-c "adapter speed 2000"
)
if [ -n "$JLINK_SERIAL" ]; then
	OPENOCD_ARGS+=(-c "adapter serial $JLINK_SERIAL")
fi
OPENOCD_ARGS+=(
	-f target/nordic/nrf53.cfg
	-c init
	-c "targets nrf53.cpunet"
	-c "program $NET_HEX verify"
	-c "targets nrf53.cpuapp"
	-c "program $APP_HEX verify"
	-c "reset run"
	-c shutdown
)

exec openocd "${OPENOCD_ARGS[@]}"