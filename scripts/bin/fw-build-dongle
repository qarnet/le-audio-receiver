#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Build the XIAO nRF54L15 HCI UART bridge as a single image.
# Build dir: build/dongle
# Result:    build/dongle/zephyr/zephyr.hex

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

REPO="$(_fw_repo_dir)"

# Accept both `fw-build-dongle -DFOO=bar` and `fw-build-dongle -- -DFOO=bar`.
if [ "${1:-}" = -- ]; then
	shift
fi

exec west build -b xiao_nrf54l15/nrf54l15/cpuapp --no-sysbuild --pristine \
	-d "$REPO/build/dongle" "$REPO/dongle/hci_uart" -- "$@"
