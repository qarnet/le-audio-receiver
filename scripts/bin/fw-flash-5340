#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF5340 firmware (app core + net core via OpenOCD TCL chain).
#
# The probe is resolved at flash time, in order:
#   1. scripts/probe-serial.local (gitignored override, single line serial)
#   2. nrf-probes --find nrf53 (auto-detect: the probe whose TARGET is an nRF53)
#   3. no serial — OpenOCD auto-detects (fine for single-probe setups)
#
# Build dir:  build/nrf5340

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/nrf5340"

if [ ! -f "$BUILD_DIR/le-audio-receiver/zephyr/zephyr.elf" ]; then
  printf 'No build artifacts found at %s\n' "$BUILD_DIR" >&2
  printf 'Build first: fw-build-5340\n' >&2
  exit 1
fi

SERIAL=""
if [ -s "scripts/probe-serial.local" ]; then
  SERIAL="$(head -n1 scripts/probe-serial.local | tr -d '[:space:]')"
  printf 'Probe %s (from scripts/probe-serial.local override)\n' "$SERIAL"
elif SERIAL="$(nrf-probes --find nrf53)"; then
  printf 'Probe %s (auto-detected: target identifies as nRF53)\n' "$SERIAL"
else
  SERIAL=""
  printf 'No nRF53 probe identified — letting OpenOCD auto-detect\n' >&2
fi

if [ -n "$SERIAL" ]; then
  exec west flash --build-dir "$BUILD_DIR" "$@" -- \
    --cmd-pre-init="adapter serial $SERIAL"
else
  exec west flash --build-dir "$BUILD_DIR" "$@"
fi
