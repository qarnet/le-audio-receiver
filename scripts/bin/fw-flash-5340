#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Flash the nRF5340 firmware (app core + net core via OpenOCD TCL chain).
#
# Build dir:  build/nrf5340

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/nrf5340"

if [ ! -f "$BUILD_DIR/le-audio-receiver/zephyr/zephyr.elf" ]; then
  printf 'No build artifacts found at %s\n' "$BUILD_DIR" >&2
  printf 'Build first: fw-build-5340\n' >&2
  exit 1
fi

exec west flash --build-dir "$BUILD_DIR" "$@"
