#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Build the dedicated LE Audio source fixture for the XIAO nRF54L15.
#
# Build dir:  build/hil-source-nrf54l15
# Result:     build/hil-source-nrf54l15/zephyr/zephyr.elf,
#             build/hil-source-nrf54l15/zephyr/zephyr.hex

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/bin/fw-common.sh
source "$SCRIPT_DIR/fw-common.sh"

_fw_require_env

cd "$(_fw_repo_dir)"

BUILD_DIR="$(_fw_repo_dir)/build/hil-source-nrf54l15"

exec west build -b nrf54l15dk/nrf54l15/cpuapp --no-sysbuild --pristine \
  -d "$BUILD_DIR" hil/source/app -- "$@"
